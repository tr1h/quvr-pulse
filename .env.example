# --- Infrastructure (matches docker-compose.yml; host ports 5433/6380 to avoid clashes) ---
DATABASE_URL=postgresql://quvr:quvr@localhost:5433/quvr_pulse?schema=public
REDIS_URL=redis://localhost:6380

# --- Robinhood Chain ---
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
# Optional. When set, RPC traffic goes to Alchemy instead of the public RPC.
ALCHEMY_API_KEY=
# Optional override of the Alchemy endpoint template ({key} is replaced server-side).
ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/{key}

# --- Solana ---
# Optional keyed RPC (Helius / Alchemy / QuickNode). The free public endpoint blocks
# getTokenLargestAccounts, so Solana top holders need a keyed URL.
SOLANA_RPC_URL=

# --- Explorer (Blockscout). Without a key the public API is usually blocked by Cloudflare for servers. ---
BLOCKSCOUT_API_KEY=

# --- Social (FomoAPI.io, independent unofficial provider). Empty = onchain-only mode. ---
FOMO_API_KEY=
# Hard daily credit budget shared by web/worker/bot (free plan: 250 000 per month).
FOMO_DAILY_CREDIT_CAP=6000
# Credit budget controls (free plan = 250 000 credits/month).
FOMO_STATS_REFRESH_MINUTES=360
FOMO_MAX_AUTHORS_PER_TOKEN=3
FOMO_FEED_POLL_HOURS=12
# Paid wallet lookups (2 500 credits each) per day; on-chain author stats need the wallet.
FOMO_WALLET_LOOKUPS_PER_DAY=3
ONCHAIN_AUTHOR_DAYS=30

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# polling (default, dev) | webhook
TELEGRAM_MODE=polling
# Required in webhook mode; Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=8787

# --- Web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
